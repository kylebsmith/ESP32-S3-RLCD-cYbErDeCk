__pycache__/
*.pyc
.venv/
# The four printable parts ARE tracked - this is a 3D-printing project and the
# point of it is that somebody can download an STL and print it. They are
# regenerated byte-for-byte by ./tools/build.sh, so they are also a check: if
# they show as modified after a clean build, the geometry moved.
# The presentation mock-ups (mock-*.stl, buttons-fitted.stl) are NOT tracked -
# they are render scaffolding built by tools/render.sh, not parts, and a
# worst-case component envelope should not be mistaken for a component model.
export/stl/mock-*.stl
export/stl/buttons-fitted.stl
export/stl/assembly.stl
export/stl/*.3mf
!export/stl/.gitkeep
*.bak

# Scratch. Scraped pages and exploratory dumps belong in a temp directory, not
# here: one was committed by a `git add -A` during a research pass.
*.html
!docs/**/*.html

# Scratch SCAD files tools write to echo parameter values. One of these was
# swept into a commit by a blanket "git add -A"; it is not part of the design.
_echo_tmp.scad
_*.scad

# Vendor documentation mirrored for local reference only.
# docs/PROVENANCE.md: no Waveshare file is redistributed by this repo.
# Rebuild with: tools/fetch_reference.sh
reference/

# ESP-IDF build output and per-machine configuration.
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old

# Fetched by the IDF component manager. dependencies.lock pins the versions
# and IS committed, so a build six months from now is the build that was
# tested; the sources themselves do not belong in this repository.
firmware/managed_components/

# libssh2 is vendored by tag under firmware/components/ssh/vendor. Its .git
# directory is not ours to carry.
firmware/components/ssh/vendor/.git/
